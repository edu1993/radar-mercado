{
  "name": "radar-mercado",
  "version": "2.1.0",
  "description": "Radar Mercado — Plataforma web full stack de análisis de precios multi-tienda y co-piloto de compra con Gemini",
  "scripts": {
    "dev": "vite",
    "dev:backend": "nodemon server/index.js",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/unit/*.test.js tests/api/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:api": "node --test tests/api/*.test.js",
    "test:scrapers": "python3 -m unittest discover -s scrapers/tests -p \"test_*.py\" -v"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "axios": "^1.8.4",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "lucide-react": "^0.469.0",
    "morgan": "^1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.20",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.25.12": true
  }
}
